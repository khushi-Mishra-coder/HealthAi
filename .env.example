# ==============================================================================
# Personalized AI Health Assistant - Environment Configuration Example
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/healthai_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT Security
JWT_SECRET=your_super_secret_jwt_key_at_least_256_bits_long_for_hmac_sha256_security
JWT_EXPIRATION_MS=86400000

# Spring AI / LLM Configuration
SPRING_AI_OPENAI_API_KEY=your_openai_api_key_here
SPRING_AI_MODEL=gpt-4o-mini

# Python ML Prediction Service
ML_SERVICE_URL=http://localhost:8000/predict

# Healthcare Map / Places API (Modular external integration)
MAP_API_KEY=your_map_api_key_here
